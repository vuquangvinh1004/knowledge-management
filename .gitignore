__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.spec

.venv/
venv/
env/

# --- Dữ liệu người dùng (riêng tư, chỉ lưu local) ---
data/database/*.db
data/notes/*
data/sources/*
data/assets/*
data/settings.json
data/backups/*
data/temp/*
data/logs/*
data/exports/*

# Giữ cấu trúc thư mục
!data/database/.gitkeep
!data/notes/.gitkeep
!data/sources/.gitkeep
!data/assets/.gitkeep
!data/backups/.gitkeep
!data/temp/.gitkeep
!data/logs/.gitkeep
!data/exports/.gitkeep

assets/generated/*
!assets/generated/.gitkeep

.idea/
.vscode/
.DS_Store
Thumbs.db
